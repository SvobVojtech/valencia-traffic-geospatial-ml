# Ignore everything except reviewed portfolio files.
# Within each open directory, keep new files ignored until explicitly allowed.
/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/01_project_design.md
!/docs/02_data_preparation.md
!/notebooks/
/notebooks/*
!/notebooks/01_data_preparation.ipynb
!/data/
/data/*
!/data/README.md
!/outputs/
/outputs/*
!/outputs/figures/
/outputs/figures/*
!/outputs/figures/README.md
